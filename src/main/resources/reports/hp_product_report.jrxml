<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN"
        "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">

<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
    http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="hp_product_report" pageWidth="595" pageHeight="842"
              columnWidth="515" leftMargin="40" rightMargin="40"
              topMargin="50" bottomMargin="50">

    <parameter name="DEALER_NAME" class="java.lang.String"/>
    <parameter name="CREATED_DATE" class="java.util.Date"/>

    <field name="id" class="java.lang.Long"/>
    <field name="name" class="java.lang.String"/>
    <field name="status" class="java.lang.Integer"/>
    <field name="price" class="java.math.BigDecimal"/>
    <field name="commissionFee" class="java.math.BigDecimal"/>

    <!-- Title Section -->
    <title>
        <band height="50">
            <staticText>
                <reportElement x="0" y="0" width="515" height="30"/>
                <textElement textAlignment="Center">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[HP Product Report - ${DEALER_NAME}]]></text>
            </staticText>
        </band>
    </title>

    <!-- Column Header Section -->
    <columnHeader>
        <band height="30">
            <textField>
                <reportElement x="0" y="0" width="50" height="20"/>
                <box>
                    <topPen lineWidth="0.5" lineColor="#000000"/>
                    <leftPen lineWidth="0.5" lineColor="#000000"/>
                    <bottomPen lineWidth="0.5" lineColor="#000000"/>
                    <rightPen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <textElement textAlignment="Left"/> <!-- Aligned left -->
                <textFieldExpression><![CDATA["ID"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="50" y="0" width="200" height="20"/>
                <box>
                    <topPen lineWidth="0.5" lineColor="#000000"/>
                    <leftPen lineWidth="0.5" lineColor="#000000"/>
                    <bottomPen lineWidth="0.5" lineColor="#000000"/>
                    <rightPen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <textElement textAlignment="Left"/> <!-- Aligned left -->
                <textFieldExpression><![CDATA["Name"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="250" y="0" width="70" height="20"/>
                <box>
                    <topPen lineWidth="0.5" lineColor="#000000"/>
                    <leftPen lineWidth="0.5" lineColor="#000000"/>
                    <bottomPen lineWidth="0.5" lineColor="#000000"/>
                    <rightPen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <textElement textAlignment="Left"/> <!-- Aligned left -->
                <textFieldExpression><![CDATA["Status"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="320" y="0" width="80" height="20"/>
                <box>
                    <topPen lineWidth="0.5" lineColor="#000000"/>
                    <leftPen lineWidth="0.5" lineColor="#000000"/>
                    <bottomPen lineWidth="0.5" lineColor="#000000"/>
                    <rightPen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <textElement textAlignment="Left"/> <!-- Aligned left -->
                <textFieldExpression><![CDATA["Price"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="400" y="0" width="115" height="20"/>
                <box>
                    <topPen lineWidth="0.5" lineColor="#000000"/>
                    <leftPen lineWidth="0.5" lineColor="#000000"/>
                    <bottomPen lineWidth="0.5" lineColor="#000000"/>
                    <rightPen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <textElement textAlignment="Left"/> <!-- Aligned left -->
                <textFieldExpression><![CDATA["Commission Fee"]]></textFieldExpression>
            </textField>
        </band>
    </columnHeader>

    <!-- Detail Section -->
    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="50" height="20"/>
                <box>
                    <topPen lineWidth="0.5" lineColor="#000000"/>
                    <leftPen lineWidth="0.5" lineColor="#000000"/>
                    <bottomPen lineWidth="0.5" lineColor="#000000"/>
                    <rightPen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <textFieldExpression><![CDATA[$F{id}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="50" y="0" width="200" height="20"/>
                <box>
                    <topPen lineWidth="0.5" lineColor="#000000"/>
                    <leftPen lineWidth="0.5" lineColor="#000000"/>
                    <bottomPen lineWidth="0.5" lineColor="#000000"/>
                    <rightPen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <textFieldExpression><![CDATA[$F{name}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="250" y="0" width="70" height="20"/>
                <box>
                    <topPen lineWidth="0.5" lineColor="#000000"/>
                    <leftPen lineWidth="0.5" lineColor="#000000"/>
                    <bottomPen lineWidth="0.5" lineColor="#000000"/>
                    <rightPen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="320" y="0" width="80" height="20"/>
                <box>
                    <topPen lineWidth="0.5" lineColor="#000000"/>
                    <leftPen lineWidth="0.5" lineColor="#000000"/>
                    <bottomPen lineWidth="0.5" lineColor="#000000"/>
                    <rightPen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <textFieldExpression><![CDATA[$F{price}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="400" y="0" width="115" height="20"/>
                <box>
                    <topPen lineWidth="0.5" lineColor="#000000"/>
                    <leftPen lineWidth="0.5" lineColor="#000000"/>
                    <bottomPen lineWidth="0.5" lineColor="#000000"/>
                    <rightPen lineWidth="0.5" lineColor="#000000"/>
                </box>
                <textFieldExpression><![CDATA[$F{commissionFee}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

</jasperReport>