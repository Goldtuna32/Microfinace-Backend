<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="HpRegistrationDetailReport" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <!-- Parameters -->
    <parameter name="hpRegistration" class="com.sme.dto.HpRegistrationDTO"/>
    <parameter name="hpProduct" class="net.sf.jasperreports.engine.data.JRBeanCollectionDataSource"/>
    <parameter name="HP_PRODUCT_SUBREPORT" class="net.sf.jasperreports.engine.JasperReport"/>

    <!-- Title Band -->
    <title>
        <band height="50">
            <textField>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["HP Registration Detail Report - " + $P{hpRegistration}.getHpNumber()]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="30" width="555" height="20"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Generated on: ]]></text>
            </staticText>
            <textField>
                <reportElement x="100" y="30" width="455" height="20"/>
                <textElement textAlignment="Left"/>
                <textFieldExpression><![CDATA[new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm:ss").format(new java.util.Date())]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- Detail Band -->
    <detail>
        <band height="300">
            <staticText>
                <reportElement x="0" y="0" width="100" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[HP ID:]]></text>
            </staticText>
            <textField>
                <reportElement x="110" y="0" width="445" height="20"/>
                <textFieldExpression><![CDATA[$P{hpRegistration}.getId()]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="20" width="100" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[HP Number:]]></text>
            </staticText>
            <textField>
                <reportElement x="110" y="20" width="445" height="20"/>
                <textFieldExpression><![CDATA[$P{hpRegistration}.getHpNumber()]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="40" width="100" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Created Date:]]></text>
            </staticText>
            <textField>
                <reportElement x="110" y="40" width="445" height="20"/>
                <textFieldExpression><![CDATA[$P{hpRegistration}.getCreatedDate() != null ? $P{hpRegistration}.getCreatedDate().format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm:ss")) : "N/A"]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="60" width="100" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Loan Amount:]]></text>
            </staticText>
            <textField>
                <reportElement x="110" y="60" width="445" height="20"/>
                <textFieldExpression><![CDATA[$P{hpRegistration}.getLoanAmount()]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="80" width="100" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Down Payment:]]></text>
            </staticText>
            <textField>
                <reportElement x="110" y="80" width="445" height="20"/>
                <textFieldExpression><![CDATA[$P{hpRegistration}.getDownPayment()]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="100" width="100" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Loan Term:]]></text>
            </staticText>
            <textField>
                <reportElement x="110" y="100" width="445" height="20"/>
                <textFieldExpression><![CDATA[$P{hpRegistration}.getLoanTerm() + " months"]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="120" width="100" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Interest Rate:]]></text>
            </staticText>
            <textField>
                <reportElement x="110" y="120" width="445" height="20"/>
                <textFieldExpression><![CDATA[$P{hpRegistration}.getInterestRate() + "%"]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="140" width="100" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Start Date:]]></text>
            </staticText>
            <textField>
                <reportElement x="110" y="140" width="445" height="20"/>
                <textFieldExpression><![CDATA[$P{hpRegistration}.getStartDate() != null ? $P{hpRegistration}.getStartDate().format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy")) : "N/A"]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="160" width="100" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[End Date:]]></text>
            </staticText>
            <textField>
                <reportElement x="110" y="160" width="445" height="20"/>
                <textFieldExpression><![CDATA[$P{hpRegistration}.getEndDate() != null ? $P{hpRegistration}.getEndDate().format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy")) : "N/A"]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="180" width="100" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Status:]]></text>
            </staticText>
            <textField>
                <reportElement x="110" y="180" width="445" height="20"/>
                <textFieldExpression><![CDATA[$P{hpRegistration}.getStatus()]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="200" width="100" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Grace Period:]]></text>
            </staticText>
            <textField>
                <reportElement x="110" y="200" width="445" height="20"/>
                <textFieldExpression><![CDATA[$P{hpRegistration}.getGracePeriod() + " days"]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="220" width="100" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Late Fee Rate:]]></text>
            </staticText>
            <textField>
                <reportElement x="110" y="220" width="445" height="20"/>
                <textFieldExpression><![CDATA[$P{hpRegistration}.getLate_fee_rate() + "%"]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- Subreport for HP Product -->
    <summary>
        <band height="50">
            <subreport>
                <reportElement x="0" y="0" width="555" height="50"/>
                <dataSourceExpression><![CDATA[$P{hpProduct}]]></dataSourceExpression>
                <subreportExpression><![CDATA[$P{HP_PRODUCT_SUBREPORT}]]></subreportExpression>
            </subreport>
        </band>
    </summary>
</jasperReport>