<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="HpProductSubreport" pageWidth="555" pageHeight="842" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">

    <!-- Fields matching HpProductDTO -->
    <field name="id" class="java.lang.Long"/>
    <field name="name" class="java.lang.String"/>
    <field name="status" class="java.lang.Integer"/>
    <field name="price" class="java.math.BigDecimal"/>
    <field name="productTypeId" class="java.lang.Long"/>
    <field name="dealerRegistrationId" class="java.lang.Long"/>
    <field name="commissionFee" class="java.math.BigDecimal"/>
    <field name="hpProductPhoto" class="java.lang.String"/>

    <title>
        <band height="30">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[HP Product Details]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="80" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="80" y="0" width="100" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Name]]></text>
            </staticText>
            <staticText>
                <reportElement x="180" y="0" width="80" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Price]]></text>
            </staticText>
            <staticText>
                <reportElement x="260" y="0" width="80" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Commission]]></text>
            </staticText>
            <staticText>
                <reportElement x="340" y="0" width="215" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Photo]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="50"> <!-- Increased height to accommodate image -->
            <textField>
                <reportElement x="0" y="0" width="80" height="20"/>
                <textFieldExpression><![CDATA[$F{id}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="80" y="0" width="100" height="20"/>
                <textFieldExpression><![CDATA[$F{name}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="180" y="0" width="80" height="20"/>
                <textFieldExpression><![CDATA[$F{price}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="260" y="0" width="80" height="20"/>
                <textFieldExpression><![CDATA[$F{commissionFee}]]></textFieldExpression>
            </textField>
            <image>
                <reportElement x="340" y="0" width="50" height="50"/>
                <imageExpression><![CDATA[$F{hpProductPhoto}]]></imageExpression>
            </image>
        </band>
    </detail>
</jasperReport>