<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="HpRepaymentSchedule" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <!-- Parameters -->
    <parameter name="hpRegistrationId" class="java.lang.Long"/>

    <!-- Fields matching HpScheduleDTO -->
    <field name="id" class="java.lang.Long"/>
    <field name="date" class="java.time.LocalDateTime"/>
    <field name="interestAmount" class="java.lang.Long"/>
    <field name="principalAmount" class="java.lang.Long"/>
    <field name="lateDay" class="java.lang.Long"/>
    <field name="lateFee" class="java.math.BigDecimal"/>
    <field name="principalOd" class="java.lang.String"/>
    <field name="interestOd" class="java.lang.String"/>
    <field name="installmentNo" class="java.lang.String"/>
    <field name="hpRegistrationId" class="java.lang.Long"/>
    <field name="lateFeePaidDate" class="java.time.LocalDateTime"/>

    <!-- Title Band -->
    <title>
        <band height="50">
            <textField>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["HP Repayment Schedule Report - HP ID: " + $P{hpRegistrationId}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="30" width="555" height="20"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Generated on: ]]></text>
            </staticText>
            <textField>
                <reportElement x="100" y="30" width="455" height="20"/>
                <textElement textAlignment="Left"/>
                <textFieldExpression><![CDATA[new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm:ss").format(new java.util.Date())]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <!-- Column Header -->
    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="50" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="50" y="0" width="80" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Due Date]]></text>
            </staticText>
            <staticText>
                <reportElement x="130" y="0" width="70" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Interest]]></text>
            </staticText>
            <staticText>
                <reportElement x="200" y="0" width="70" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Principal]]></text>
            </staticText>
            <staticText>
                <reportElement x="270" y="0" width="60" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Late Days]]></text>
            </staticText>
            <staticText>
                <reportElement x="330" y="0" width="70" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Late Fee]]></text>
            </staticText>
            <staticText>
                <reportElement x="400" y="0" width="70" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Installment]]></text>
            </staticText>
            <staticText>
                <reportElement x="470" y="0" width="85" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Paid Date]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detail Band -->
    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="50" height="20"/>
                <textFieldExpression><![CDATA[$F{id}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="50" y="0" width="80" height="20"/>
                <textFieldExpression><![CDATA[$F{date} != null ? $F{date}.format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy")) : "N/A"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="130" y="0" width="70" height="20"/>
                <textFieldExpression><![CDATA[$F{interestAmount}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="200" y="0" width="70" height="20"/>
                <textFieldExpression><![CDATA[$F{principalAmount}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="270" y="0" width="60" height="20"/>
                <textFieldExpression><![CDATA[$F{lateDay}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="330" y="0" width="70" height="20"/>
                <textFieldExpression><![CDATA[$F{lateFee}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="400" y="0" width="70" height="20"/>
                <textFieldExpression><![CDATA[$F{installmentNo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="470" y="0" width="85" height="20"/>
                <textFieldExpression><![CDATA[$F{lateFeePaidDate} != null ? $F{lateFeePaidDate}.format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy")) : "N/A"]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- No Data Band (optional) -->
    <noData>
        <band height="50">
            <staticText>
                <reportElement x="0" y="0" width="555" height="50"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[No repayment schedules found for HP ID: ]]></text>
            </staticText>
            <textField>
                <reportElement x="200" y="0" width="100" height="50"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$P{hpRegistrationId}]]></textFieldExpression>
            </textField>
        </band>
    </noData>
</jasperReport>